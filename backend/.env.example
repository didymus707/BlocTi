# Postgres for the API (`npm run dev`)
DATABASE_URL="postgresql://YOUR_PG_USER@localhost:5432/bloc_ti_dev"
# Postgres database the API tests create, migrate and wipe (`npm test`)
TEST_DATABASE_URL="postgresql://YOUR_PG_USER@localhost:5432/bloc_ti_test"
PORT=4000
# how far a client-supplied occurredAt may be from server time, in seconds
MAX_CLOCK_SKEW_SEC=300
